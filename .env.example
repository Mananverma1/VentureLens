# Copy this file to ".env" and fill in your OWN real values.
# NEVER commit ".env" and NEVER paste real tokens into chat/docs.

# Groq — https://console.groq.com  (free tier, generous rate limits)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily — https://app.tavily.com  (free tier: 1,000 searches/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for reasoning agents (LiteLLM format)
# Groq options: groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant
# HF options:   huggingface/Qwen/Qwen3-8B
MODEL_ID=groq/llama-3.3-70b-versatile

# Hugging Face token (only needed if using HF-hosted models above)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pin a specific HF Inference Provider (leave blank for auto)
HF_PROVIDER=
